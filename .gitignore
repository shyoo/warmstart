# Private working notes — prompt history, personal scratch. Never committed.
internal_docs/
# Machine-local Codex probe databases and temporary plugin clones.
transient_docs/codexprobe/

# Dependencies
node_modules/
.pnpm-store/

# Build output
out/
dist/
build/
*.tsbuildinfo

# Electron / native
.electron-builder-cache/
release/

# scripts/build-win.ps1's step stamps: a SHA-256 of each step's inputs, so an unchanged
# step is skipped. Machine-local by definition - it describes this checkout's out\ and release\.
.build-cache/

# Local runtime state. agentyard's own state lives in the OS app-data dir, not here,
# but a dev run may drop a scratch DB.
*.db
*.db-journal
*.db-wal
*.sqlite

# This project's own Warmstart config, ignored whole.
#
# ⚠️ **A project's `.warmstart/project.json` is normally committed** — that is the point of it, and
# docs/glossary.md says so: a collaborator or a fresh clone reproduces the same behaviour. This repo
# is the exception, because it is also the machine that develops the tool: its own file carries an
# absolute `workspaces.root` outside the repo, which is exactly what that file is documented never to
# contain. Ignoring it here keeps one developer's paths out of everybody's clone; it is not a change
# to what the file means anywhere else.
#
# ⛔ The pre-rename directory stays listed as well. `readProjectConfig` still *reads* it for other
# people's repositories — see projects.ts — but nothing of ours belongs in one again.
.warmstart/
.multi_agent_controller/

# Env and secrets
.env
.env.*
!.env.example

# Editors / OS / Agent Aliases
.agent/
.agents/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# The Electron runtime download, shared by @electron/get and electron-builder in CI.
.electron-cache/

# Scratch from scripts/icons.mjs, cleaned up on success
.icons-*/

# Local dev/deploy scripts
deploy-local.ps1
scripts/deploy-local.ps1
deploy-local.sh
scripts/deploy-local.sh
