# Private working notes — prompt history, personal scratch. Never committed.
internal_docs/

# Dependencies
node_modules/
.pnpm-store/

# Build output
out/
dist/
build/
*.tsbuildinfo

# Electron / native
.electron-builder-cache/
release/

# scripts/build-win.ps1's step stamps: a SHA-256 of each step's inputs, so an unchanged
# step is skipped. Machine-local by definition - it describes this checkout's out\ and release\.
.build-cache/

# Local runtime state. agentyard's own state lives in the OS app-data dir, not here,
# but a dev run may drop a scratch DB.
*.db
*.db-journal
*.db-wal
*.sqlite

# Local overrides of committed project policy (.multi_agent_controller/project.json IS committed — see
# docs/glossary.md; only the local override is not)
.multi_agent_controller/local.json
.multi_agent_controller/state/

# Env and secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# The Electron runtime download, shared by @electron/get and electron-builder in CI.
.electron-cache/

# Scratch from scripts/icons.mjs, cleaned up on success
.icons-*/
