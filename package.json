{
  "name": "warmstart",
  "version": "0.1.0",
  "description": "A desktop control room that keeps multiple AI coding agents moving across tasks, accounts, quota windows, and human decisions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyoo/warmstart.git"
  },
  "homepage": "https://github.com/shyoo/warmstart#readme",
  "bugs": {
    "url": "https://github.com/shyoo/warmstart/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run version:check && npm run typecheck && electron-vite build && npm run build:mobile",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "start": "electron-vite preview",
    "typecheck": "npm run version:check && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "version:check": "node scripts/check-version.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:daemon": "node test/daemon.test.mjs",
    "test:ui": "node test/ui.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "test:all": "npm run test && npm run test:daemon && npm run test:ui",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:release": "npm run build && electron-builder --mac -c.mac.notarize=true",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:pack": "node test/pack.test.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "katex": "^0.18.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "author": "Sunghwan Yoo"
}
